{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draku",
  "version": "0.1.0",
  "identifier": "app.draku.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Draku",
        "width": 1160,
        "height": 780,
        "minWidth": 940,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#050405"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "assets/ocr/": "assets/ocr/",
      "resources/models/": "models/",
      "resources/DirectML.dll": ""
    }
  }
}
